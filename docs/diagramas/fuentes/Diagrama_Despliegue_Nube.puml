@startuml Diagrama_Despliegue_Nube
!include skin.iuml
title Diagrama de Despliegue (UML 2.5) — BellaStyle Manager en la nube
skinparam node {
  BackgroundColor #F9F9F9
  BorderColor #555555
}
skinparam artifact {
  BackgroundColor #FCF1F6
  BorderColor #B03A78
}

node "PC / celular del usuario" <<device>> as U {
  node "Navegador web\n(Chrome, Safari, Edge)" <<executionEnvironment>> as NAV {
    artifact "Páginas HTML + estilos.css + js/*.js\n(copia descargada del servidor)" as FRONTCOPY
  }
}

node "Servidor Render (nube)\nservicio web «bellastyle»" <<device>> as RENDER {
  node "Node.js 20" <<executionEnvironment>> as NODE {
    node "Express 4" <<executionEnvironment>> as EXP {
      artifact "backend/\napp.js · routes · controllers\nmodels · config · utils" as BACK
      artifact "frontend/\nHTML · css · js · img" as FRONT
    }
  }
}

node "Servidor Aiven (nube)\nservicio «bellastyle-mysql»" <<device>> as AIVEN {
  node "MySQL Server 8.4" <<executionEnvironment>> as MYSQL {
    database "bellastylemanager\n(17 tablas)" <<schema>> as BD
  }
}

node "Google Cloud" <<device>> as GOOGLE {
  node "Gemini API" <<executionEnvironment>> as GEM {
    artifact "Modelo gemma-4-26b-a4b-it\n(respaldo: gemini-flash-lite-latest)" as MODELO
  }
}

node "GitHub" <<device>> as GH {
  artifact "Repositorio\nbellastyle-manager (rama main)" as REPO
}

node "PC del desarrollador\n(Windows)" <<device>> as DEV {
  artifact "presentacion_proaula/\nproaula_bella/" as LOCAL
}

U "0..*" -- "1" RENDER : "«HTTPS»\npuerto 443\nHTML + JSON"
EXP ..> FRONT : "sirve con\nexpress.static"
FRONT ..> FRONTCOPY : "se descarga\nal navegador"
RENDER -- AIVEN : "«TCP + SSL»\nprotocolo MySQL"
RENDER -- GOOGLE : "«HTTPS»\nx-goog-api-key"
DEV -- GH : "«HTTPS»\ngit push"
GH -- RENDER : "«HTTPS»\nnpm install + node app.js"

note bottom of RENDER
  Las claves no están en el código: Render las entrega
  como variables de entorno (DB_HOST, DB_PORT, DB_USER,
  DB_PASSWORD, DB_NAME, DB_SSL, GEMINI_API_KEY, CODIGO_ADMIN).
  El proyecto también incluye Dockerfile y docker-compose.yml
  para ejecutarlo en contenedores en cualquier equipo.
end note
@enduml
