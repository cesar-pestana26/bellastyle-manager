@startuml Modelo_Datos
!include skin.iuml
title Modelo relacional — base de datos bellastylemanager (22 tablas)
skinparam linetype ortho
left to right direction
entity usuarios {
  * id_usuario : INT <<PK>>
  --
  nombre : VARCHAR(100)
  username : VARCHAR(50) <<UNIQUE>>
  password : VARCHAR(255)
  rol : ENUM
  telefono : VARCHAR(30)
  email : VARCHAR(120)
  creado_en : TIMESTAMP
}
entity clientas {
  * id_clienta : INT <<PK>>
  --
  id_usuario : INT <<FK, UNIQUE>>
  nombres, apellidos : VARCHAR(80)
  telefono : VARCHAR(30)
  email : VARCHAR(120)
  profesion : VARCHAR(80)
}
entity estilistas {
  * id_estilista : INT <<PK>>
  --
  id_usuario : INT <<FK, UNIQUE>>
  nombres, apellidos : VARCHAR(80)
  especialidad : VARCHAR(80)
  estado : ENUM
}
entity servicios {
  * id_servicio : INT <<PK>>
  --
  nombre : VARCHAR(100)
  precio : DECIMAL(10,2)
  duracion_min : INT
  publico : ENUM (Mujer, Hombre, Unisex)
  estado : ENUM
}
entity productos {
  * id_producto : INT <<PK>>
  --
  nombre : VARCHAR(100)
  precio : DECIMAL(10,2)
  stock : INT
  estado : ENUM
}
entity estilista_servicios {
  * id_estilista : INT <<PK, FK>>
  * id_servicio : INT <<PK, FK>>
}
entity citas {
  * id_cita : INT <<PK>>
  --
  id_cliente : INT <<FK>>
  id_estilista : INT <<FK>>
  id_servicio : INT <<FK>>
  fecha : DATE
  hora : TIME
  precio : DECIMAL(10,2)
  estado : ENUM
  observaciones : TEXT
  notas_servicio : VARCHAR(500)
  reprogramaciones : TINYINT
}
entity horarios {
  * id_horario : INT <<PK>>
  --
  id_estilista : INT <<FK>>
  dia_semana : TINYINT
  hora_inicio, hora_fin : TIME
}
entity ausencias {
  * id_ausencia : INT <<PK>>
  --
  id_estilista : INT <<FK>>
  fecha_inicio, fecha_fin : DATE
  motivo : VARCHAR(120)
}
entity calificaciones {
  * id_calificacion : INT <<PK>>
  --
  id_cita : INT <<FK, UNIQUE>>
  estrellas : TINYINT (1 a 5)
  comentario : VARCHAR(300)
}
entity mensajes_cita {
  * id_mensaje : INT <<PK>>
  --
  id_cita : INT <<FK>>
  autor : ENUM
  texto : VARCHAR(500)
  leido : BOOLEAN
}
entity conversaciones {
  * id_conversacion : INT <<PK>>
  --
  codigo : CHAR(32) <<UNIQUE>>
  nombre : VARCHAR(60)
  contacto : VARCHAR(120)
  estado : ENUM
}
entity mensajes {
  * id_mensaje : INT <<PK>>
  --
  id_conversacion : INT <<FK>>
  autor : ENUM
  texto : VARCHAR(500)
  leido : BOOLEAN
}
entity fotos_servicio {
  * id_foto : INT <<PK>>
  --
  id_servicio : INT <<FK>>
  tipo : VARCHAR(20)
  datos : MEDIUMBLOB
}
entity fotos_producto {
  * id_producto : INT <<PK, FK>>
  --
  tipo : VARCHAR(20)
  datos : MEDIUMBLOB
}
entity fotos_perfil {
  * id_usuario : INT <<PK, FK>>
  --
  tipo : VARCHAR(20)
  datos : MEDIUMBLOB
}
entity vitrina {
  * id_foto : INT <<PK>>
  --
  id_usuario : INT <<FK>>
  tipo : VARCHAR(20)
  datos : MEDIUMBLOB
  descripcion : VARCHAR(120)
}
entity pagos {
  * id_pago : INT <<PK>>
  --
  id_cita : INT <<FK, UNIQUE>>
  referencia : VARCHAR(30) <<UNIQUE>>
  metodo : ENUM
  monto : DECIMAL(10,2)
  estado : ENUM
  comprobante : VARCHAR(40)
  fecha_pago : TIMESTAMP
}
entity pago_salon {
  * id : TINYINT <<PK>> (siempre 1)
  --
  llave : VARCHAR(80)
  titular : VARCHAR(100)
  qr_tipo : VARCHAR(20)
  qr_datos : MEDIUMBLOB
  actualizado : TIMESTAMP
}
entity pedidos {
  * id_pedido : INT <<PK>>
  --
  id_clienta : INT <<FK>>
  total : DECIMAL(10,2)
  estado : ENUM
  creado_en : TIMESTAMP
}
entity pedido_items {
  * id_item : INT <<PK>>
  --
  id_pedido : INT <<FK>>
  id_producto : INT <<FK>>
  cantidad : INT
  precio : DECIMAL(10,2)
}
entity migraciones {
  * nombre : VARCHAR(60) <<PK>>
  --
  aplicada : TIMESTAMP
}
usuarios ||--o| clientas
usuarios ||--o| estilistas
usuarios ||--o| fotos_perfil
usuarios ||--o{ vitrina
estilistas ||--o{ estilista_servicios
servicios ||--o{ estilista_servicios
clientas ||--o{ citas
estilistas ||--o{ citas
servicios ||--o{ citas
estilistas ||--o{ horarios
estilistas ||--o{ ausencias
citas ||--o| calificaciones
citas ||--o{ mensajes_cita
citas ||--o| pagos
conversaciones ||--o{ mensajes
servicios ||--o{ fotos_servicio
productos ||--o| fotos_producto
clientas ||--o{ pedidos
pedidos ||--|{ pedido_items
productos ||--o{ pedido_items
@enduml
